# 复制在浏览器登录 music.163.com 后的 Cookie (必填，需包含 MUSIC_U 与 __csrf)
NETEASE_COOKIE="MUSIC_U=replace_me; __csrf=replace_me"

# 接收一起听邀请的网易云数字用户 ID (选填: 纯 HTTP 模式下若未入房，会自动接受该用户发来的私信邀请卡片)
NETEASE_LISTEN_TOGETHER_ACCEPTOR_ID="replace_with_numeric_user_id"

# 反向代理 Bearer 鉴权 Token (选填: 用于 Nginx 反向代理校验，可运行 openssl rand -hex 32 生成)
MCP_AUTH_TOKEN="replace_with_random_secret_token"
